# Klartext — Konfiguration. Kopie als .env anlegen, Werte setzen, chmod 600.
# Niemals in Git aufnehmen (.gitignore deckt .env ab).

# --- Produkt ---------------------------------------------------------------
PRODUCT_NAME=Klartext
PUBLIC_URL=https://klartext.it-handwerk-stuttgart.de
APP_PORT=8160

# --- Datenbank (nur im internen Docker-Netz erreichbar) --------------------
POSTGRES_DB=klartext
POSTGRES_USER=klartext
POSTGRES_PASSWORD=BITTE-ERSETZEN
DATABASE_URL=postgresql://klartext:BITTE-ERSETZEN@db:5432/klartext

# --- Docling (nie oeffentlich, nur serverseitig angesprochen) --------------
DOCLING_URL=http://docling:5001
DOCLING_API_KEY=BITTE-ERSETZEN
DOCLING_NUM_WORKERS=2
DOCLING_NUM_THREADS=2
DOCLING_DOC_TIMEOUT=900
DOCLING_MEM_LIMIT=8G
DOCLING_CPU_LIMIT=4.0

# OCR: rapidocr — Apache-2.0 bei Engine und Modellen, deutlich beste Erkennung bei
# Fotos und Tabellen in Bildern. Alternative: tesseract (ebenfalls Apache-2.0, aber
# schwächer bei Bild-Tabellen). easyocr bleibt aus: für die Modellgewichte gibt es
# keine eigenständige Lizenzangabe. Siehe THIRD_PARTY_LICENSES.md
OCR_ENGINE=rapidocr
OCR_LANG=deu,eng
TABLE_MODE=accurate
# Tabellen mit verbundenen Zellen: html schreibt sie als HTML-Tabelle ins Markdown
# und behält damit rowspan/colspan. raster bleibt beim flachen Markdown-Raster, in
# dem jede überdeckte Stelle denselben Text trägt. Die JSON-Ausgabe enthält die
# Verbünde in beiden Fällen.
MERGED_TABLES=html

# --- Speicher --------------------------------------------------------------
UPLOAD_DIR=/data/uploads
RESULT_DIR=/data/results

# --- Sitzungen -------------------------------------------------------------
SESSION_COOKIE=klartext_session
SESSION_HOURS=72
# In Produktion hinter HTTPS immer true. Nur fuer lokale Tests ohne TLS auf false.
COOKIE_SECURE=true
TRUST_PROXY_HEADER=true

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=2
JOB_STALE_MINUTES=30

# --- Fair-Use-Grenzen (zur Laufzeit im Admin-Bereich aenderbar) ------------
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=5
MAX_PAGES=100
JOBS_PER_HOUR=30
JOBS_PER_DAY=100
PAGES_PER_DAY=600
MB_PER_DAY=300
MAX_ACTIVE_JOBS=2
MAX_QUEUED_JOBS=10
GLOBAL_QUEUE_LIMIT=200
RETENTION_HOURS=24

# --- Missbrauchsschutz -----------------------------------------------------
LOGIN_ATTEMPTS_PER_15MIN=10
REGISTER_PER_HOUR_PER_IP=5
REQUESTS_PER_MINUTE_PER_IP=240

# --- E-Mail (optional; ohne SMTP keine Verifizierung, kein Passwort-Reset) --
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Rechtliche Pflichtangaben ---------------------------------------------
# Leer lassen, solange die echten Angaben nicht feststehen. Die Seiten weisen dann
# sichtbar darauf hin. Es werden bewusst keine Angaben erfunden.
LEGAL_OPERATOR=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_RESPONSIBLE=

# --- Reichweitenmessung (optional) -------------------------------------------
# Selbst betriebenes Plausible auf demselben Rechner. Leer lassen schaltet die
# Messung ab. Das Zaehlskript wird ueber die eigene Domain ausgeliefert, damit
# die Seite keinen Fremd-Request ausloest und die strenge CSP unveraendert bleibt.
# Gemessen wird nur auf den oeffentlichen Seiten, nie im angemeldeten Bereich.
PLAUSIBLE_URL=
PLAUSIBLE_DOMAIN=
