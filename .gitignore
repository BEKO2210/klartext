# Zugangsdaten — niemals ins Repository
.env
.env.*
!.env.example

# Sicherungen enthalten Datenbankabzüge und Kopien der .env mit echten Passwörtern
backups/
*.bak
*.sql.gz

# Laufzeitdaten: hochgeladene Dateien und Ergebnisse der Nutzer
data/

# Zwischenstände der Markenentwicklung (grosse Rasterbilder)
brand/explorations/

# Werkzeuge
.playwright-cli/
__pycache__/
*.pyc
*.log

# Messstand: die gebauten Prüfdateien entstehen aus den Quellen neu
bench/dokumente/
bench/rohdaten/
bench/rohdaten-*/

# Grosse Modellgewichte, per Skript ladbar (siehe ocr/LADEN.md)
ocr/rapidocr-v6/*.onnx
ocr/tableformer-v2/model.safetensors
